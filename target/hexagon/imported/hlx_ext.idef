EXTINSN(LX_cmp_gt_uw,"Ldd16.w=cmp.gt(Luu16.uw, Lvv16.uw)",ATTRIBS(A_HLX,A_EXTENSION,A_NO_IDEF_PARSER,A_HLX_SHIFT,A_RESTRICT_SLOT2ONLY,A_HLX_PAIRED_ALU),"Word element compare greater than",
