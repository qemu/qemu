&rd_imm     rd  imm                                                  !extern

%imm        0:s16 16:16

@rd_imm     ...... rd:5  ..... ................ ................    &rd_imm imm=%imm

LI_nnms     011000 ..... 00000 ................ ................    @rd_imm
