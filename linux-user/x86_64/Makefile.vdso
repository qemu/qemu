include $(BUILD_DIR)/linux-user/x86_64/config-target.mak

SUBDIR = $(SRC_PATH)/linux-user/x86_64
VPATH += $(SUBDIR)

all: $(SUBDIR)/vdso.so

$(SUBDIR)/vdso.so: vdso.S vdso.ld
	$(CC) -o $@ -nostdlib -shared -Wl,-h,linux-vdso.so.1 \
	  -Wl,--build-id=sha1 -Wl,--hash-style=both \
	  -Wl,-T,$(SUBDIR)/vdso.ld $<
