config HEX_DSP
    bool
    default y
    depends on HEXAGON
    select CPU_CLUSTER
    select HEX_L2VIC
    select HEX_QTIMER
    select ARM_COMPATIBLE_SEMIHOSTING

config HEX_BOARD
    bool
    depends on HEX_DSP && FDT
    select DEVICE_TREE
    select VIRTIO_MMIO
    select PL011

config HEX_VIRT
    bool
    default y
    depends on HEX_DSP && FDT
    select HEX_BOARD
    select VIRTIO_BLK
    select VIRTIO_SCSI
